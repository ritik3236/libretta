# ---- Database (MySQL) ----
# NOTE: URL-encode special characters in the password (e.g. "+" -> "%2B").
# For Vercel serverless at scale, front this with Prisma Accelerate or a pooler (see SPEC.md §6).
DATABASE_URL="mysql://user:password@host:3306/dbname?connection_limit=5"

# ---- Clerk ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
