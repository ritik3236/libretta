# ============================================================
# REQUIRED — the app will not run without these
# ============================================================

# MySQL connection. URL-encode special chars in the password (e.g. "+" -> "%2B").
# For Vercel serverless at scale, front this with Prisma Accelerate / a pooler (see SPEC.md §6).
DATABASE_URL="mysql://user:password@host:3306/dbname?connection_limit=5"

# Clerk auth keys (from the Clerk dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ============================================================
# OPTIONAL — only needed for the Clerk user-sync webhook
# (a fallback in requireUser() creates the DB user without it)
# ============================================================
CLERK_WEBHOOK_SECRET=

# ============================================================
# OPTIONAL — Clerk routing. Clerk has defaults, but these point
# auth at our custom /sign-in & /sign-up pages and land users on
# /dashboard. Safe to keep (public, non-secret). Remove to use
# Clerk's hosted pages + default redirects.
# ============================================================
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ============================================================
# OPTIONAL — app base URL (used for absolute links)
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# OPTIONAL (DEV ONLY) — bypass Clerk auth with a seeded local user
# ============================================================
# Set to "true" to skip Clerk entirely and act as user "user_demo_seed"
# (matches prisma/seed.ts). Useful for local/preview work without Clerk's
# *.accounts.dev handshake. Hard-gated by NODE_ENV: ignored in production builds.
#   Tip: run `SEED_USER_ID=user_demo_seed pnpm db:seed` to populate demo data.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
# Roles granted to the bypass user (comma-separated). Set to "admin" to reach
# the /admin area locally. In production, roles come from Clerk publicMetadata.roles.
NEXT_PUBLIC_DEV_ROLES=
